# 复制为 .env（本目录）后填入本地口令。run.sh / run.bat 会自动加载；
# 可选的 MySQL 容器用 docker compose --env-file server/.env up -d。
# 此模板刻意不含任何真实口令。
CHEMERA_DB_HOST=localhost
CHEMERA_DB_PORT=3306
CHEMERA_DB_NAME=chemera
CHEMERA_DB_USER=chem
CHEMERA_DB_PASSWORD=
# 备份账号（tools/backup.sh 用）：由 server/db/bootstrap.sql 创建，权限只有读 + FLUSH_TABLES
CHEMERA_BACKUP_USER=chem_bak
CHEMERA_BACKUP_PASSWORD=
# 至少 32 字节的随机串：openssl rand -base64 48
CHEMERA_JWT_SECRET=
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql,dev
# 首次启动创建的超管口令；留空则回落弱默认并打印告警，生产 profile 下留空会直接拒绝启动
CHEMERA_SEED_ADMIN_USER=admin
CHEMERA_SEED_ADMIN_PASS=

# ---------------- 跨域（CORS）----------------
# 默认（开发）值已经写在 application.yml 里：http://localhost:*,http://127.0.0.1:* ——
# 那是给"前端热调 + 后台 dev server"用的，本机任意端口都能调，出了本机就无效。
# 匹配的是 allowedOriginPatterns（WebConfig#addCorsMappings），带 credentials，所以**不允许**用 "*"。
#
# 安卓壳（Capacitor）里 WebView 的来源是 https://localhost：
#   · 前端 fetch 会被 CapacitorHttp 接管成原生请求，压根不带 Origin，服务端这层其实用不上；
#   · 但一旦某个请求没被接管（比如插件没装、或以后改用 XHR 之外的通道），浏览器就会按 CORS 拦下来，
#     表现是"apk 里登录永远转圈、日志看不出所以然"。所以把这行留着当保险，成本为零。
# 生产：只在确实要让网页跨域调用时填自己的域名；APK 不需要额外开，填 https://localhost 即可。
# 留空 = 完全不下发跨域许可（application-prod.yml 的默认，ProdHardening 会在生产填了值时打告警）。
CHEMERA_CORS_ORIGINS=

# ---------------- 广告 / TapTap（服务端侧）----------------
# 与安卓构建用的同名变量是**同一把钥匙**，两边不一致签名就对不上：
# 口令只在这里存在（本文件被 git 忽略），代码、文档、脚本、回归里都不出现明文。
# SSV 回调签名密钥（后台【广告配置】发奖验签用；留空则 dev 模式放行回调）
CHEMERA_AD_SECURITY_KEY=
# 平台侧激励视频代码位；留空则用安卓构建里注入的那个（BuildConfig.AD_SPACE_ID）
CHEMERA_AD_SPACE_ID=
CHEMERA_TAPTAP_CLIENT_ID=
# 两条自证通道（客户端凭工单白拿奖励 / dev: 票据直接换账号）在 application.yml 里**默认关闭**，
# 裸启动与上线实例都是关的。本机联调要么带 dev profile（上面那行），要么把下面两项显式设 true；
# 带 prod 启动时开着它们会被 ProdHardening 直接拒绝启动。
# 注意：对接真机/提审前这两项必须是 false，否则广告面等于无限提款机。
CHEMERA_AD_DEV_MODE=true
CHEMERA_TAPTAP_DEV_MODE=true

